{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TempMailDb": "Server=(localdb)\\MSSQLLocalDB;Database=TempMailOtp;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "EmailProvider": {
    "Provider": "MailTm",
    "MailTm": {
      "BaseUrl": "https://api.mail.tm/",
      "DisplayName": "mail.tm",
      "AttributionText": "Temporary addresses powered by mail.tm",
      "AttributionUrl": "https://mail.tm",
      "TimeoutSeconds": 15,
      "MaxRequestsPerSecond": 6,
      "DomainCacheMinutes": 30
    }
  },
  "TempMail": {
    "InboxLifetimeMinutes": 60,
    "ClientPollIntervalSeconds": 8,
    "SyncIntervalSeconds": 5,
    "ManualRefreshMinIntervalSeconds": 2,
    "MaxMessagesPerSync": 25,
    "CleanupEnabled": true,
    "CleanupIntervalMinutes": 5,
    "ExpiredRetentionMinutes": 15,
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "RateLimiting": {
    "GeneratePermitLimit": 10,
    "GenerateWindowSeconds": 600,
    "RefreshPermitLimit": 30,
    "RefreshWindowSeconds": 60,
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "ReverseProxy": {
    "Enabled": false
  },
  "OpenApi": {
    "EnableInProduction": false
  }
}
