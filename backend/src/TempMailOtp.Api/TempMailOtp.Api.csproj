<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TempMailOtp.Api</RootNamespace>
    <AssemblyName>TempMailOtp.Api</AssemblyName>
    <UserSecretsId>681c76f4-2875-4ef1-b172-288f80359954</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- HTML sanitization for received emails (brings AngleSharp, used for HTML-to-text). -->
    <PackageReference Include="HtmlSanitizer" Version="9.0.*" />
    <!-- Built-in OpenAPI document generation (/openapi/v1.json). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Swagger UI pointed at the built-in OpenAPI document. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="9.0.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TempMailOtp.Tests" />
  </ItemGroup>

</Project>
