# Sample backend configuration as environment variables (ASP.NET Core maps "__" to ":").
# ASP.NET Core does not read this file by itself: export these in your shell, your hosting
# platform, or use `dotnet user-secrets` for local development (see README). No real secrets here.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# SQL Server (Docker example; LocalDB is the default in appsettings.json)
ConnectionStrings__TempMailDb=Server=localhost,1433;Database=TempMailOtp;User Id=sa;Password=<your-sa-password>;TrustServerCertificate=True;Encrypt=True

# Apply EF Core migrations automatically at startup (true in Development by default)
Database__ApplyMigrationsOnStartup=true

# Email provider: MailTm (real email, no API key needed) or Demo (simulated, clearly labeled)
EmailProvider__Provider=MailTm
EmailProvider__MailTm__BaseUrl=https://api.mail.tm/
EmailProvider__MailTm__MaxRequestsPerSecond=6

# Inbox behaviour
TempMail__InboxLifetimeMinutes=60
TempMail__ClientPollIntervalSeconds=8
TempMail__ExpiredRetentionMinutes=15
TempMail__AllowedOrigins__0=http://localhost:4200

# Persist Data Protection keys (they encrypt stored mailbox passwords). Required in containers.
DataProtection__KeysPath=./.keys

# Set true when running behind a reverse proxy that sends X-Forwarded-For / X-Forwarded-Proto
ReverseProxy__Enabled=false
